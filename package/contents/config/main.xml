  Configuration keys of the widget; this file is the reference for their
  names, types and defaults.
-->
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <group name="General">
    <!-- Schema version of the stored settings; not shown in the settings dialog. -->
    <entry name="configVersion" type="Int">
      <default>1</default>
    </entry>
  </group>

  <group name="Display">
    <entry name="layout" type="String">
      <default>auto</default>
    </entry>
    <entry name="uploadFirst" type="Bool">
      <default>false</default>
    </entry>
    <entry name="combined" type="Bool">
      <default>false</default>
    </entry>
    <entry name="unitSystem" type="String">
      <default>iec</default>
    </entry>
    <entry name="shortUnits" type="Bool">
      <default>false</default>
    </entry>
    <entry name="decimals" type="Int">
      <default>-1</default>
    </entry>
    <entry name="lowSpeedThreshold" type="Int">
      <default>1024</default>
    </entry>
    <!-- Seconds between two updates. -->
    <entry name="updateInterval" type="Double">
      <default>1.0</default>
      <min>0.5</min>
      <max>10</max>
    </entry>
  </group>

  <group name="Appearance">
    <!-- Empty uses the font of the Plasma theme. -->
    <entry name="fontFamily" type="String">
      <default></default>
    </entry>
    <entry name="fontBold" type="Bool">
      <default>false</default>
    </entry>
    <!-- Text size in percent. -->
    <entry name="fontScale" type="Int">
      <default>100</default>
      <min>50</min>
      <max>200</max>
    </entry>
    <!-- arrows, triangles, icons, none or custom. -->
    <entry name="iconStyle" type="String">
      <default>arrows</default>
    </entry>
    <entry name="customDownIcon" type="String">
      <default>↓</default>
    </entry>
    <entry name="customUpIcon" type="String">
      <default>↑</default>
    </entry>
    <!-- theme, direction or thresholds. -->
    <entry name="colorMode" type="String">
      <default>theme</default>
    </entry>
    <!-- #rrggbb; empty uses the theme's colour. -->
    <entry name="downloadColor" type="String">
      <default></default>
    </entry>
    <entry name="uploadColor" type="String">
      <default></default>
    </entry>
    <!-- JSON list of up to six levels: { "min": bytes per second, "color": "#rrggbb" or "" }. -->
    <entry name="colorThresholds" type="String">
      <default>[{"min":0,"color":""},{"min":1048576,"color":"#1d99f3"},{"min":10485760,"color":"#f67400"},{"min":104857600,"color":"#da4453"}]</default>
    </entry>
    <entry name="colorUnits" type="Bool">
      <default>false</default>
    </entry>
    <entry name="fixedWidth" type="Bool">
      <default>true</default>
    </entry>
    <!-- off, background or beside. -->
    <entry name="sparkline" type="String">
      <default>off</default>
    </entry>
  </group>

  <group name="Data">
    <entry name="dataSource" type="String">
      <default>auto</default>
    </entry>
    <entry name="interfaceSelection" type="String">
      <default>auto</default>
    </entry>
    <entry name="selectedInterfaces" type="StringList">
      <default></default>
    </entry>
  </group>

  <group name="Behavior">
    <entry name="leftClick" type="String">
      <default>popup</default>
    </entry>
    <entry name="middleClick" type="String">
      <default>none</default>
    </entry>
    <entry name="launchKind" type="String">
      <default>app</default>
    </entry>
    <entry name="launchApp" type="String">
      <default>org.kde.plasma-systemmonitor</default>
    </entry>
    <entry name="launchCommand" type="String">
      <default></default>
    </entry>
    <!-- never, offline or idle. -->
    <entry name="autoHide" type="String">
      <default>never</default>
    </entry>
    <!-- Bytes per second below which the connection counts as idle (at least 1 KiB/s). -->
    <entry name="idleThreshold" type="Int">
      <default>1024</default>
      <min>1024</min>
    </entry>
    <!-- Seconds below the threshold before the connection counts as idle. -->
    <entry name="idleSeconds" type="Int">
      <default>30</default>
      <min>5</min>
      <max>3600</max>
    </entry>
  </group>

  <group name="Popup">
    <!-- Minutes of history in the popup graph; 1, 5 or 15. -->
    <entry name="graphMinutes" type="Int">
      <default>5</default>
    </entry>
  </group>
</kcfg>
